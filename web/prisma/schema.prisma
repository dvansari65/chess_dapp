// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                 Int          @id @default(autoincrement())
  userName           String       @unique
  publickey          String       @unique
  status             playerStatus @default(offline)
  matchesPlayed      Int          @default(0)
  wins               Int          @default(0)
  lost               Int          @default(0)
  rating             Int          @default(0)
  solWon             Int          @default(0)
  createdAt          DateTime
  isPlaying          Boolean      @default(false)
  sentChallenges     Challenge[]  @relation("sender")
  recievedChallenges Challenge[]  @relation("receiver")
  player1InGame      Game?        @relation("player1")
  player2InGame      Game?        @relation("player2")
}

model Challenge {
  id             Int             @id @default(autoincrement())
  senderPubKey   String
  amount         Float
  receiverPubKey String
  sender         Player          @relation("sender", fields: [senderPubKey], references: [publickey])
  receiver       Player          @relation("receiver", fields: [receiverPubKey], references: [publickey])
  createdAt      DateTime
  expiresAt      DateTime
  status         ChallengeStatus
}

model Game {
  id            Int        @id @default(autoincrement())
  onChainGameId Int?        @unique  
  player1PubKey String     @unique
  player1       Player     @relation("player1", fields: [player1PubKey], references: [publickey])
  player2PubKey String     @unique
  player2       Player     @relation("player2", fields: [player2PubKey], references: [publickey])
  status        GameStatus @default(pending)
  wageredAmount Int
  createdAt     DateTime
  finishedAt    DateTime?
}

enum playerStatus {
  Online
  offline
}

enum ChallengeStatus {
  pending
  accepted
  rejected
  expired
}

enum GameStatus {
  pending
  waitingForOnChainGameId
  draw
  finished
}
